# 统一行尾，避免跨平台协作者满屏 diff
* text=auto eol=lf

# Windows 脚本按 CRLF 检出，保证双击与 cmd 可直接运行
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资产不做行尾转换
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.db binary
*.so binary

# diff 时可读性处理
*.lock linguist-generated=true
Cargo.lock linguist-generated=true
pubspec.lock linguist-generated=true

# 语言统计归类（避免 Flutter 模板文件与截图影响语言占比）
docs/** linguist-documentation
frontend/android/** linguist-vendored
